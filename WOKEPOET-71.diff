+const widget = computed(() => AppConfig('item-check') as ItemCheckWidget)
+const bookmarks = computed(() => widget.value.bookmarks)
+const shown = computed(() => matchBookmarks(bookmarks.value, filter.value))
+
+const keys = computed<LookupKeys>(() => ({
+  wiki: panelKey(widget.value.wikiKey),
+  poedb: panelKey(widget.value.poedbKey),
+  coe: panelKey(widget.value.craftOfExileKey),
+  bookmarks: panelKey(widget.value.bookmarksKey)
+}))
+const activeKey = computed(() => tab.value === 'bookmarks' || tab.value === 'page' ? null : keys.value[tab.value])
+const popOutTitle = computed(() => activeKey.value ? `Open in your browser (${activeKey.value})` : 'Open in your browser')
+
+const itemTabs = computed(() => lookupTabs(props.request.item, props.request.tab))
+const tabOptions = computed(() => [
+  ...itemTabs.value.map(t => ({ value: t as PanelTab, label: TAB_LABELS[t], count: keys.value[t] ?? undefined })),
+  ...(page.value ? [{ value: 'page' as PanelTab, label: page.value.name, count: undefined }] : []),
+  { value: 'bookmarks' as PanelTab, label: 'Bookmarks', count: keys.value.bookmarks ?? (bookmarks.value.length || undefined) }
+])
+
+const urls = computed(() => {
+  const language = AppConfig().language
+  const out: Partial<Record<PanelTab, string>> = {}
+  const { item } = props.request
+  if (item) {
+    for (const t of itemTabs.value) out[t] = lookupUrl(t, item, language)
+  }
+  if (page.value) out.page = page.value.url
+  return out
+})
+
+const liveUrl = computed(() => currentUrls.value[tab.value] ?? urls.value[tab.value])
+const starred = computed(() => bookmarks.value.some(b => b.url === liveUrl.value))
+const starTitle = computed(() => starred.value ? 'Remove from bookmarks' : 'Save to bookmarks')
+
+function selectTab (t: PanelTab) {
+  if (t !== 'bookmarks' && !opened.value.includes(t)) opened.value = [...opened.value, t]
+  tab.value = t
+}
+
+function toggleStar () {
+  const url = viewUrl(tab.value) || urls.value[tab.value]
+  widget.value.bookmarks = toggleBookmark(bookmarks.value, url, viewTitle(tab.value))
+  currentUrls.value = { ...currentUrls.value, [tab.value]: url }
+}
+
+function openBookmark (b: Bookmark) {
+  // The same link doesn't reload the view, so one you've browsed away from needs telling.
+  const view = page.value?.id === b.id ? views.get('page') : undefined
+  if (view && viewUrl('page') !== b.url) view.src = b.url
+  page.value = b
+  currentUrls.value = { ...currentUrls.value, page: undefined }
+  selectTab('page')
+}
+
+// No "are you sure": remove now, offer Undo.
+function remove (b: Bookmark) {
+  const at = bookmarks.value.findIndex(o => o.id === b.id)
+  widget.value.bookmarks = bookmarks.value.filter(o => o.id !== b.id)
+  toast(`Removed "${b.name}"`, {
+    anchor: panel.value?.el,
+    undo: () => {
+      const list = bookmarks.value
+      if (list.some(o => o.url === b.url)) return
+      widget.value.bookmarks = [...list.slice(0, at), b, ...list.slice(at)]
+    }
+  })
+}
+
+function openExternal (url: string) {
+  if (!isWebUrl(url)) return
+  window.open(url)
+  emit('close')
+}
+
+function popOut () {
+  const fallback = urls.value[tab.value]
+  if (fallback) openExternal(popOutUrl(viewUrl(tab.value), fallback))
+}
+
+function close () {
+  emit('close')
+  Host.sendEvent({ name: 'OVERLAY->MAIN::focus-game', payload: undefined })
+}
+
+// With the overlay focused the game's hotkeys are off, so main passes these on.
+const keyController = MainProcess.onEvent('MAIN->OVERLAY::woke-panel-key', ({ key }) => {
+  const action = lookupKeyAction(key, tab.value, itemTabs.value, keys.value)
+  if (!action) return
+  if (action.type === 'switch') {
+    selectTab(action.tab)
+    lastJumpAt = performance.now()
+  } else if (performance.now() - lastJumpAt >= POP_OUT_GUARD_MS) {
+    popOut()
+  }
+})
+
+function sendKeys (list: string[]) {
+  Host.sendEvent({ name: 'OVERLAY->MAIN::woke-panel-keys', payload: { keys: list } })
+}
+
+onMounted(() => {
+  sendKeys(Object.values(keys.value).filter((k): k is string => k != null))
+})
+onBeforeUnmount(() => {
+  keyController.abort()
+  sendKeys([])
+})
+</script>
diff --git a/renderer/src/web/woke/item-lookup/lookup.ts b/renderer/src/web/woke/item-lookup/lookup.ts
new file mode 100644
index 00000000..b320362e
--- /dev/null
+++ b/renderer/src/web/woke/item-lookup/lookup.ts
@@ -0,0 +1,128 @@
+// The in-overlay page for an item: which sites it has, their links, and what a
+// hotkey does while the page is open.
+import { shallowRef } from 'vue'
+import type { ParsedItem } from '@/parser'
+
+export type LookupTab = 'wiki' | 'poedb' | 'coe'
+
+export const TAB_LABELS: Record<LookupTab, string> = {
+  wiki: 'Wiki',
+  poedb: 'poedb',
+  coe: 'Craft of Exile'
+}
+
+// The panel's other two tabs: the saved list, and a saved page you opened from it.
+export type PanelTab = LookupTab | 'bookmarks' | 'page'
+
+export type LookupKeys = Record<LookupTab | 'bookmarks', string | null>
+
+export interface Bookmark {
+  id: number
+  name: string
+  url: string
+}
+
+export interface LookupRequest {
+  // No item when the bookmarks hotkey opened it.
+  item: ParsedItem | null
+  tab: LookupTab | 'bookmarks'
+  // Screen position of the hotkey press, which picks the panel's side.
+  position?: { x: number, y: number }
+}
+
+// The hotkey event for opening the panel on its bookmarks, with no item.
+export const BOOKMARKS_TARGET = 'item-lookup-bookmarks'
+
+// Read by the item info widget, which shows the panel.
+export const lookupRequest = shallowRef<LookupRequest | null>(null)
+
+const POEDB_LANGS: Record<string, string> = {
+  'en': 'us',
+  'ru': 'ru',
+  'cmn-Hant': 'tw',
+  'ko': 'kr'
+}
+
+type UrlItem = Pick<ParsedItem, 'rawText'> & { info: Pick<ParsedItem['info'], 'refName'> }
+
+export function lookupUrl (tab: LookupTab, item: UrlItem, language: string): string {
+  const refName = item.info.refName
+  switch (tab) {
+    case 'wiki':
+      return `https://www.poewiki.net/wiki/${encodeURIComponent(refName.replaceAll(' ', '_'))}`
+    case 'poedb': {
+      const slug = encodeURIComponent(refName.replaceAll("'", '').replaceAll(' ', '_'))
+      return `https://poedb.tw/${POEDB_LANGS[language] ?? 'us'}/${slug}`
+    }
+    case 'coe':
+      return `https://craftofexile.com/?game=poe1&eimport=${encodeURIComponent(item.rawText)}`
+  }
+}
+
+type CraftFacts = { info: { craftable?: unknown }, isCorrupted: boolean, isMirrored?: boolean }
+
+export function canCraft (item: CraftFacts): boolean {
+  return Boolean(item.info.craftable) && !item.isCorrupted && !item.isMirrored
+}
+
+// Craft of Exile can't do anything with a corrupted or mirrored item, so it only
+// gets a tab for those when you asked for it by its hotkey.
+export function lookupTabs (item: CraftFacts | null, opened: LookupTab | 'bookmarks'): LookupTab[] {
+  if (!item) return []
+  return canCraft(item) || opened === 'coe' ? ['wiki', 'poedb', 'coe'] : ['wiki', 'poedb']
+}
+
+export type LookupKeyAction =
+  { type: 'popout' } |
+  { type: 'switch', tab: LookupTab | 'bookmarks' } |
+  null
+
+// The key of the tab you're on sends it to your browser; another tab's key goes
+// to that tab, if the item has it.
+export function lookupKeyAction (key: string, active: PanelTab, tabs: LookupTab[], keys: LookupKeys): LookupKeyAction {
+  if (active === 'bookmarks' && keys.bookmarks === key) return null
+  if (active !== 'page' && keys[active] === key) return { type: 'popout' }
+  if (keys.bookmarks === key) return { type: 'switch', tab: 'bookmarks' }
+  const tab = tabs.find(t => keys[t] === key)
+  return tab ? { type: 'switch', tab } : null
+}
+
+export function isWebUrl (url: string | undefined): url is string {
+  if (!url) return false
+  try {
+    const { protocol } = new URL(url)
+    return protocol === 'https:' || protocol === 'http:'
+  } catch {
+    return false
+  }
+}
+
+// Only web pages go out to the OS shell, whatever a page navigated to.
+export function popOutUrl (current: string | undefined, fallback: string): string {
+  return isWebUrl(current) ? current : fallback
+}
+
+// Saves the page, or removes it if it's already saved. A page that isn't a web
+// page is never saved.
+export function toggleBookmark (list: Bookmark[], url: string | undefined, title: string | undefined): Bookmark[] {
+  if (!isWebUrl(url)) return list
+  if (list.some(b => b.url === url)) return list.filter(b => b.url !== url)
+  const name = title?.trim() || new URL(url).hostname
+  return [...list, { id: Math.max(0, ...list.map(b => b.id)) + 1, name, url }]
+}
+
+export function matchBookmarks (list: Bookmark[], filter: string): Bookmark[] {
+  const needle = filter.trim().toLowerCase()
+  return list.filter(b => isWebUrl(b.url) && (!needle || b.name.toLowerCase().includes(needle) || b.url.toLowerCase().includes(needle)))
+}
+
+// The page gets the keyboard, so a key with no Ctrl or Alt would be taken from
+// whatever you type into it. Such a key doesn't work inside the panel.
+export function panelKey (key: string | null): string | null {
+  if (!key) return null
+  return /^F\d+$/.test(key) || /(^|\+ )(Ctrl|Alt) \+/.test(key) ? key : null
+}
+
+// A key press this soon after opening is a held key or a double tap, not a
+// request to leave the overlay.
+export const POP_OUT_GUARD_MS = 400
